			</property>
			<property>
				<name>Door Open Alert Minutes</name>
				<type>RANGED_INTEGER</type>
				<minimum>0</minimum>
				<maximum>120</maximum>
				<readonly>false</readonly>
				<default>2</default>
			</property>
			<property>
