	<templatedescription>SmartHQ appliance child (oven, beverage center, dishwasher, refrigerator, washer or dryer). Read-only state and events. Bind SmartHQ Bridge in Connections. UNTESTED.</templatedescription>

	<connections>
		<connection>
			<id>1</id>
			<facing>6</facing>
			<connectionname>SmartHQ Bridge</connectionname>
			<type>1</type>
			<consumer>True</consumer>
			<audiosource>False</audiosource>
			<videosource>False</videosource>
			<linelevel>False</linelevel>
			<classes>
				<class>
					<classname>SMARTHQ_BRIDGE</classname>
				</class>
			</classes>
		</connection>
	</connections>

	<config>
		<power_management_method>AlwaysOn</power_management_method>
		<power_command_delay>0</power_command_delay>
		<power_delay>0</power_delay>
		<power_command_needed>False</power_command_needed>
		<script file="driver.lua" />

		<actions>
		</actions>

		<events>
			<event>
				<id>1</id>
				<name>Oven Preheated</name>
				<description>Oven leaves preheat and enters an active state (state names UNVERIFIED)</description>
			</event>
			<event>
				<id>2</id>
				<name>Oven Timer Done</name>
				<description>Oven cook time remaining goes from above zero to zero while active (UNVERIFIED)</description>
			</event>
			<event>
				<id>3</id>
				<name>Dishwasher Done</name>
				<description>Dishwasher goes from active to idle</description>
			</event>
			<event>
				<id>4</id>
				<name>Washer Done</name>
				<description>Washer goes from active to idle</description>
			</event>
			<event>
				<id>5</id>
				<name>Dryer Done</name>
				<description>Dryer goes from active to idle</description>
			</event>
			<event>
				<id>6</id>
				<name>Door Left Open</name>
				<description>A door has been open for Door Open Alert Minutes (once per opening; 0 turns it off)</description>
			</event>
		</events>

		<properties>
			<property>
				<name>Appliance Type</name>
				<type>LIST</type>
				<readonly>false</readonly>
				<default>Oven</default>
				<items>
					<item>Oven</item>
					<item>Beverage Center</item>
					<item>Dishwasher</item>
					<item>Refrigerator</item>
