<devicedata>
	<copyright>Copyright (c) 2026 - Custom / Unofficial Driver - Not affiliated with SwitchBot or Control4</copyright>
	<creator>Custom Driver Project</creator>
	<manufacturer>SwitchBot</manufacturer>
	<name>SwitchBot Curtain</name>
	<model>SwitchBot Curtain / Curtain 3 / Blind Tilt (cloud API v1.1)</model>
	<created>11/04/2026 10:00 PM</created>
	<modified>11/04/2026 10:30 PM</modified>
	<version>3</version>
	<control>lua_gen</control>
	<controlmethod>ip</controlmethod>
	<driver>DriverWorks</driver>
	<templatedescription>SwitchBot Curtain - cloud API control (open/close/position) via a SwitchBot Hub</templatedescription>

	<proxies qty="1">
		<proxy proxybindingid="5001" name="SwitchBot Curtain" primary="True">blind</proxy>
	</proxies>

	<connections>
		<connection>
			<id>5001</id>
			<facing>6</facing>
			<connectionname>Blind</connectionname>
			<type>2</type>
			<consumer>False</consumer>
			<audiosource>False</audiosource>
			<videosource>False</videosource>
			<linelevel>False</linelevel>
			<classes>
				<class>
					<classname>BLIND</classname>
				</class>
			</classes>
		</connection>
	</connections>

	<config>
		<power_management_method>AlwaysOn</power_management_method>
		<power_command_delay>0</power_command_delay>
		<power_delay>0</power_delay>
		<power_command_needed>False</power_command_needed>
		<script file="driver.lua" />

		<commands>
			<command>
				<name>Open</name>
				<description>Open the curtain fully</description>
			</command>
			<command>
				<name>Close</name>
				<description>Close the curtain fully</description>
			</command>
			<command>
				<name>Stop</name>
				<description>Stop any movement</description>
			</command>
			<command>
				<name>Set Position</name>
				<description>Move to a Control4 level from 0 to 100 (100 = open when Invert Level is True)</description>
				<params>
					<param>
						<name>LEVEL</name>
						<type>RANGED_INTEGER</type>
						<minimum>0</minimum>
						<maximum>100</maximum>
						<default>100</default>
					</param>
				</params>
			</command>
		</commands>

		<actions>
			<action>
				<name>Discover Devices</name>
				<command>DISCOVER</command>
			</action>
		</actions>

		<properties>
			<property>
				<name>Token</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default></default>
			</property>
			<property>
				<name>Secret</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default></default>
			</property>
			<property>
				<name>Device ID</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default></default>
			</property>
			<property>
				<name>Discovered Devices</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default></default>
			</property>
			<property>
				<name>Status</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default>Not configured</default>
			</property>
			<property>
				<name>Battery</name>
				<type>RANGED_INTEGER</type>
				<minimum>0</minimum>
				<maximum>100</maximum>
				<readonly>true</readonly>
				<default>0</default>
			</property>
			<property>
				<name>Low Battery Threshold</name>
				<type>RANGED_INTEGER</type>
				<minimum>0</minimum>
				<maximum>100</maximum>
				<readonly>false</readonly>
				<default>20</default>
			</property>
			<property>
				<name>Poll Interval Seconds</name>
				<type>RANGED_INTEGER</type>
				<minimum>60</minimum>
				<maximum>3600</maximum>
				<readonly>false</readonly>
				<default>300</default>
			</property>
			<property>
				<name>Invert Level</name>
				<type>LIST</type>
				<readonly>false</readonly>
				<default>True</default>
				<items>
					<item>True</item>
					<item>False</item>
				</items>
			</property>
			<property>
				<name>Mode</name>
				<type>LIST</type>
				<readonly>false</readonly>
				<default>ff</default>
				<items>
					<item>ff</item>
					<item>0</item>
					<item>1</item>
				</items>
			</property>
			<property>
				<name>Driver Version</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default>1.0.2</default>
			</property>
		</properties>
	</config>

	<events>
		<event>
			<id>1</id>
			<name>Low Battery</name>
			<description>Battery is below the Low Battery Threshold</description>
		</event>
	</events>
</devicedata>
