<devicedata>
	<copyright>Copyright (c) 2026 - Custom / Unofficial Driver - Not affiliated with Hearth &amp; Home Technologies or Control4</copyright>
	<creator>Custom Driver Project</creator>
	<manufacturer>Hearth &amp; Home Technologies</manufacturer>
	<name>IntelliFire Fireplace (Wi-Fi Module)</name>
	<model>IFT-WFM (Off / Pilot / Flame, variable flame height)</model>
	<created>08/15/2026 12:00 PM</created>
	<modified>11/05/2026 2:05 PM</modified>
	<version>118</version>
	<small image_source="c4z">icons/device_sm.png</small>
	<large image_source="c4z">icons/device_lg.png</large>
	<control>lua_gen</control>
	<controlmethod>ip</controlmethod>
	<driver>DriverWorks</driver>
	<templatedescription>IntelliFire Wi-Fi Fireplace Module - HTTP/JSON Local Control (Off/Pilot/Flame + Level)</templatedescription>
	<search_types>
		<type>IntelliFire:fireplace:IFT-WFM</type>
	</search_types>

	<!--
		NOTE ON PROXY CHOICE (updated 2026-11-05, v118): this driver now uses
		Control4's native relaysingle_gasfireplace_c4 proxy, the same proxy stock
		Control4 fireplace drivers use. Navigator and Composer show the fireplace
		in the Comfort category as a plain on/off device, with no thermostat card,
		no Mode button and no flame-level dial. The thermostatV2 proxy used in
		v117 has been removed. v117 is the rollback point.

		Mapping used here:
		  - Relay CLOSED = main flame on, OPENED = main flame off. The proxy's
		    CLOSE / OPEN / TOGGLE commands use the same ignition path as the
		    Fireplace On / Fireplace Off Composer commands (power=1 / power=0,
		    pilot=0 on off).
		  - Pilot-only stays a separate Composer command/action.
		  - No flame-level control is exposed any more. Turning on uses the
		    fireplace's own remembered flame level.
		  - Connection status is still reported through CONNECTION.
	-->
	<proxies qty="1">
		<proxy image_source="c4z" small_image="icons/device_sm.png" large_image="icons/device_lg.png" proxybindingid="5001" name="IntelliFire Fireplace">relaysingle_gasfireplace_c4</proxy>
	</proxies>

	<connections>
		<connection>
			<id>5001</id>
			<facing>6</facing>
			<connectionname>RELAY_PROXY</connectionname>
			<type>2</type>
			<consumer>False</consumer>
			<audiosource>False</audiosource>
			<videosource>False</videosource>
			<linelevel>False</linelevel>
			<classes>
				<class>
					<classname>RELAY</classname>
				</class>
			</classes>
		</connection>
		<connection>
			<id>6001</id>
			<facing>1</facing>
			<connectionname>Network</connectionname>
			<type>4</type>
			<consumer>True</consumer>
			<audiosource>False</audiosource>
			<videosource>False</videosource>
			<linelevel>True</linelevel>
			<classes>
				<class>
					<classname>TCP</classname>
					<ports>
						<port>
							<number>80</number>
							<auto_connect>True</auto_connect>
							<monitor_connection>True</monitor_connection>
							<keep_connection>False</keep_connection>
						</port>
					</ports>
				</class>
			</classes>
		</connection>
	</connections>

	<capabilities>
	    <navigator_display_option proxybindingid="5001">
      <display_icons>
        <Icon width="1024" height="1024">controller://driver/IntelliFire_driver/icons/device/flame/experience_1024.png</Icon>
        <Icon width="512" height="512">controller://driver/IntelliFire_driver/icons/device/flame/experience_512.png</Icon>
        <Icon width="300" height="300">controller://driver/IntelliFire_driver/icons/device/flame/experience_300.png</Icon>
        <Icon width="90" height="90">controller://driver/IntelliFire_driver/icons/device/flame/experience_90.png</Icon>
        <Icon width="70" height="70">controller://driver/IntelliFire_driver/icons/device/flame/experience_70.png</Icon>
      </display_icons>
    </navigator_display_option>
	</capabilities>

	<config>
		<power_management_method>AlwaysOn</power_management_method>
		<power_command_delay>0</power_command_delay>
		<power_delay>0</power_delay>
		<power_command_needed>False</power_command_needed>
		<documentation file="www\documentation.rtf" />
		<script file="driver.lua" />

		<commands>
			<command>
				<name>Set Pilot</name>
				<description>Turn the standing pilot on or off (independent of main flame)</description>
				<params>
					<param>
						<name>State</name>
						<type>LIST</type>
						<items>
							<item>ON</item>
							<item>OFF</item>
						</items>
					</param>
				</params>
			</command>
			<command>
				<name>Fireplace On</name>
				<description>Turn the main flame on</description>
			</command>
			<command>
				<name>Fireplace Off</name>
				<description>Turn the main flame off</description>
			</command>
		</commands>

		<actions>
			<action>
				<name> - Pilot On</name>
				<command>ACTION_PILOT_ON</command>
			</action>
			<action>
				<name> - Pilot Off</name>
				<command>ACTION_PILOT_OFF</command>
			</action>
			<action>
				<name> - Fireplace On</name>
				<command>ACTION_FIREPLACE_ON</command>
			</action>
			<action>
				<name> - Fireplace Off</name>
				<command>ACTION_FIREPLACE_OFF</command>
			</action>
			<action>
				<name> - Refresh Status</name>
				<command>ACTION_REFRESH_STATUS</command>
			</action>
			<action>
				<name> - Print Debug Info</name>
				<command>ACTION_PRINT_DEBUG</command>
			</action>
		</actions>

		<properties>
			<property>
				<name>Driver Version</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default></default>
			</property>
			<property>
				<name>Fireplace IP Address</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default>0.0.0.0</default>
			</property>
			<property>
				<name>API User ID</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default></default>
			</property>
			<!--
				NOTE: type is STRING, not PASSWORD/masked. The reference
				Haiku_SenseME_driver.xml in this project only uses STRING and
				LIST for property types - no masked/secret type appears there,
				so PASSWORD was not carried over unverified. Newer Control4 OS
				versions may support a masked property type; if DriverEditor's
				property-type autocomplete offers one, it's worth switching to
				for this field, but confirm it in the editor first.
			-->
			<property>
				<name>API Key</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default></default>
			</property>
			<property>
				<name>Poll Interval (seconds)</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default>20</default>
			</property>
			<property>
				<name>Log Mode</name>
				<type>LIST</type>
				<readonly>false</readonly>
				<default>Off</default>
				<items>
					<item>Off</item>
					<item>Print</item>
					<item>Log</item>
					<item>Print and Log</item>
				</items>
			</property>
			<property>
				<name>Connection Status</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default>Unknown</default>
			</property>
		</properties>
	</config>

	<composer_categories>
		<category>Comfort</category>
	</composer_categories>
	<navigator_categories>
		<category>Comfort</category>
	</navigator_categories>
</devicedata>
