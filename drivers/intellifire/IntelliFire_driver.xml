	<templatedescription>IntelliFire Wi-Fi Fireplace Module - HTTP/JSON Local Control (Off/Pilot/Flame + Level)</templatedescription>
	<search_types>
		<type>IntelliFire:fireplace:IFT-WFM</type>
	</search_types>

	<!--
		NOTE ON PROXY CHOICE (updated 2026-08-15): there is still no native
		Control4 "fireplace" proxy, but this driver now uses thermostatV2
		instead of light_v2. Reasoning: light_v2-bound devices are pulled
		into a room's Lighting group by Navigator/Composer, which means
		"All Lights Off" scenes, lighting keypad buttons, and similar
		programming would silently also kill the fireplace - not obviously
		desirable, and not how commercial Control4 fireplace drivers do it
		(e.g. the Elite Fire Proflame2 driver on drivercentral.io explicitly
		uses "familiar thermostat style controls" for this exact reason).

		Mapping used here:
		  - HVAC Mode "Off"/"Heat"  -> main flame off / on (same ignition
		    sequence as before: pilot first if needed, then power).
		  - Heat Setpoint (0-100)   -> flame height, via the same
		    percent<->height conversion this driver already used for
		    light_v2's LEVEL. This is an intensity dial re-using the
		    thermostat setpoint control, not a real temperature - the "F"
		    units shown are cosmetic, same trick the commercial driver uses.
		  - Pilot-only stays a separate Composer command/action (thermostatV2
		    has no "pilot" concept), same as before.
		  - No ambient temperature sensor exists on this hardware, so the
		    current-temperature readout on the Navigator thermostat card
		    will show as unavailable/blank - expected, not a bug.
	-->
	<proxies qty="1">
		<proxy image_source="c4z" small_image="icons/device_sm.png" large_image="icons/device_lg.png" proxybindingid="5001" name="IntelliFire Fireplace">thermostatV2</proxy>
	</proxies>

	<connections>
		<connection>
			<id>5001</id>
			<facing>6</facing>
			<connectionname>FIREPLACE</connectionname>
			<type>2</type>
			<consumer>False</consumer>
			<audiosource>False</audiosource>
			<videosource>False</videosource>
			<linelevel>False</linelevel>
			<classes>
				<class>
					<classname>THERMOSTAT</classname>
				</class>
			</classes>
		</connection>
		<connection>
			<id>6001</id>
			<facing>1</facing>
			<connectionname>Network</connectionname>
			<type>4</type>
			<consumer>True</consumer>
			<audiosource>False</audiosource>
			<videosource>False</videosource>
			<linelevel>True</linelevel>
			<classes>
				<class>
					<classname>TCP</classname>
					<ports>
						<port>
							<number>80</number>
							<auto_connect>True</auto_connect>
							<monitor_connection>True</monitor_connection>
							<keep_connection>False</keep_connection>
						</port>
					</ports>
				</class>
			</classes>
		</connection>
	</connections>

	<!--
		thermostatV2 capabilities. Structure confirmed against a real,
		published thermostatV2 driver (bphillips09/Control4-HA-Thermostat on
		GitHub) rather than guessed. can_cool/can_auto/has_extras/etc. are
		all False since this fireplace only ever needs Off/Heat + one
		setpoint acting as the flame-intensity dial.

		2026-08-16 (seventh session): added the setpoint_single_* fields
		below. The real reference driver always defines heat/cool/single
		setpoint ranges together even when has_single_setpoint is false -
		this driver was missing the single_* fields entirely, which may be
		part of why the setpoint control didn't render correctly in the
		Control4 App. Kept in sync with setpoint_heat_* since this device
		only ever has one active setpoint.
	-->
	<capabilities>
    <navigator_display_option proxybindingid="5001">
      <display_icons>
        <Icon width="1024" height="1024">controller://driver/IntelliFire_driver/icons/device/flame/experience_1024.png</Icon>
        <Icon width="512" height="512">controller://driver/IntelliFire_driver/icons/device/flame/experience_512.png</Icon>
        <Icon width="300" height="300">controller://driver/IntelliFire_driver/icons/device/flame/experience_300.png</Icon>
        <Icon width="90" height="90">controller://driver/IntelliFire_driver/icons/device/flame/experience_90.png</Icon>
        <Icon width="70" height="70">controller://driver/IntelliFire_driver/icons/device/flame/experience_70.png</Icon>
      </display_icons>
    </navigator_display_option>

		<has_remote_sensor>false</has_remote_sensor>
		<can_heat>true</can_heat>
		<can_cool>false</can_cool>
		<can_change_scale>false</can_change_scale>
		<has_extras>false</has_extras>
		<has_single_setpoint>false</has_single_setpoint>
		<can_do_auto>false</can_do_auto>
		<can_auto>false</can_auto>
		<can_calibrate>false</can_calibrate>

		<setpoint_heat_min_f>1</setpoint_heat_min_f>
		<setpoint_heat_max_f>5</setpoint_heat_max_f>
		<setpoint_heat_min_c>1</setpoint_heat_min_c>
		<setpoint_heat_max_c>5</setpoint_heat_max_c>
		<setpoint_heat_min>1</setpoint_heat_min>
		<setpoint_heat_max>5</setpoint_heat_max>

		<setpoint_single_min_f>1</setpoint_single_min_f>
		<setpoint_single_max_f>5</setpoint_single_max_f>
		<setpoint_single_min_c>1</setpoint_single_min_c>
		<setpoint_single_max_c>5</setpoint_single_max_c>

		<fan_states>Off</fan_states>
		<hvac_states>Off,Heat</hvac_states>
		<has_connection_status>true</has_connection_status>

		<can_preset_schedule>false</can_preset_schedule>
		<can_preset>false</can_preset>
	</capabilities>

	<config>
		<power_management_method>AlwaysOn</power_management_method>
		<power_command_delay>0</power_command_delay>
		<power_delay>0</power_delay>
		<power_command_needed>False</power_command_needed>
		<documentation file="www\documentation.rtf" />
		<script file="driver.lua" />

		<commands>
			<command>
				<name>Set Pilot</name>
				<description>Turn the standing pilot on or off (independent of main flame)</description>
				<params>
					<param>
						<name>State</name>
						<type>LIST</type>
						<items>
							<item>ON</item>
							<item>OFF</item>
						</items>
					</param>
				</params>
			</command>
		</commands>

		<actions>
			<action>
				<name> - Pilot On</name>
				<command>ACTION_PILOT_ON</command>
			</action>
			<action>
				<name> - Pilot Off</name>
				<command>ACTION_PILOT_OFF</command>
			</action>
			<action>
				<name> - Refresh Status</name>
				<command>ACTION_REFRESH_STATUS</command>
			</action>
			<action>
				<name> - Print Debug Info</name>
				<command>ACTION_PRINT_DEBUG</command>
			</action>
		</actions>

		<properties>
			<property>
				<name>Fireplace IP Address</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default>0.0.0.0</default>
			</property>
			<property>
				<name>API User ID</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default></default>
			</property>
			<!--
				NOTE: type is STRING, not PASSWORD/masked. The reference
				Haiku_SenseME_driver.xml in this project only uses STRING and
				LIST for property types - no masked/secret type appears there,
				so PASSWORD was not carried over unverified. Newer Control4 OS
				versions may support a masked property type; if DriverEditor's
				property-type autocomplete offers one, it's worth switching to
				for this field, but confirm it in the editor first.
			-->
			<property>
				<name>API Key</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default></default>
			</property>
			<property>
				<name>Poll Interval (seconds)</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default>20</default>
			</property>
			<property>
				<name>Log Mode</name>
				<type>LIST</type>
				<readonly>false</readonly>
				<default>Off</default>
				<items>
					<item>Off</item>
					<item>Print</item>
					<item>Log</item>
					<item>Print and Log</item>
				</items>
			</property>
			<property>
				<name>Connection Status</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default>Unknown</default>
			</property>
		</properties>
	</config>

	<composer_categories>
		<category>Comfort</category>
	</composer_categories>
	<navigator_categories>
		<category>Comfort</category>
	</navigator_categories>
