	<capabilities>
		<!-- The page file is renamed every page release (remote1, remote2, ...).
		     web_view_url, PAGE_BUILD in driver.lua and the file in www/ must agree. -->
		<web_view_url proxybindingid="5001">controller://driver/shield-remote/remote1.html</web_view_url>
		<mobile_web_view_enabled>true</mobile_web_view_enabled>
		<navigator_display_option proxybindingid="5001">
			<display_icons>
				<Icon width="70" height="70">controller://driver/shield-remote/icons/device/experience_70.png</Icon>
				<Icon width="90" height="90">controller://driver/shield-remote/icons/device/experience_90.png</Icon>
				<Icon width="300" height="300">controller://driver/shield-remote/icons/device/experience_300.png</Icon>
				<Icon width="512" height="512">controller://driver/shield-remote/icons/device/experience_512.png</Icon>
				<Icon width="1024" height="1024">controller://driver/shield-remote/icons/device/experience_1024.png</Icon>
				<state id="Default">
					<Icon width="70" height="70">controller://driver/shield-remote/icons/device/experience_70.png</Icon>
					<Icon width="90" height="90">controller://driver/shield-remote/icons/device/experience_90.png</Icon>
					<Icon width="300" height="300">controller://driver/shield-remote/icons/device/experience_300.png</Icon>
					<Icon width="512" height="512">controller://driver/shield-remote/icons/device/experience_512.png</Icon>
					<Icon width="1024" height="1024">controller://driver/shield-remote/icons/device/experience_1024.png</Icon>
				</state>
			</display_icons>
		</navigator_display_option>
	</capabilities>
	<templatedescription>Navigator remote for an NVIDIA Shield TV: D-pad, Back, Home, Menu, media transport, room volume and mute, with a Now Playing strip read from the Shield TV bridge driver. UNTESTED.</templatedescription>

