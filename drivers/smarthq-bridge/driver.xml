	<creator>Custom Driver Project</creator>
	<manufacturer>Custom</manufacturer>
	<name>SmartHQ Hub</name>
	<model>SmartHQ Hub (parent, read-only LAN bridge client)</model>
	<created>11/12/2026 12:00 PM</created>
	<modified>11/12/2026 10:01 PM</modified>
	<version>11</version>
	<small image_source="c4z">icons/device_sm.png</small>
	<large image_source="c4z">icons/device_lg.png</large>
	<control>lua_gen</control>
	<controlmethod>ip</controlmethod>
	<driver>DriverWorks</driver>
	<combo>true</combo>
	<proxies />
	<capabilities />
	<templatedescription>SmartHQ parent. Polls the liesa LAN bridge (/inventory) and pushes each appliance's state to its bound SmartHQ Appliance and SmartHQ Hood Light children. Only write: hood light on/off/dim/high. UNTESTED.</templatedescription>

	<connections>
		<connection>
			<id>1</id>
			<facing>6</facing>
			<connectionname>SmartHQ Appliances</connectionname>
			<type>1</type>
			<consumer>False</consumer>
			<audiosource>False</audiosource>
			<videosource>False</videosource>
			<linelevel>False</linelevel>
			<classes>
				<class>
					<classname>SMARTHQ_BRIDGE</classname>
				</class>
			</classes>
		</connection>
	</connections>

	<config>
		<power_management_method>AlwaysOn</power_management_method>
		<power_command_delay>0</power_command_delay>
		<power_delay>0</power_delay>
		<power_command_needed>False</power_command_needed>
		<script file="driver.lua" />

		<actions>
			<action>
				<name>Refresh Now</name>
				<command>REFRESH_NOW</command>
			</action>
			<action>
				<name>List Appliances</name>
				<command>LIST_APPLIANCES</command>
			</action>
		</actions>

		<events>
			<event>
				<id>1</id>
				<name>Bridge Unreachable</name>
				<description>Fires once when the bridge stops responding or reports unusable (inventory not 200 or not JSON)</description>
			</event>
		</events>

		<properties>
			<property>
				<name>Host</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default>172.21.1.157</default>
			</property>
			<property>
				<name>Port</name>
				<type>RANGED_INTEGER</type>
				<minimum>1</minimum>
				<maximum>65535</maximum>
				<readonly>false</readonly>
				<default>8789</default>
			</property>
			<property>
				<name>Poll Interval</name>
				<type>RANGED_INTEGER</type>
				<minimum>30</minimum>
				<maximum>3600</maximum>
				<readonly>false</readonly>
				<default>60</default>
			</property>
			<property>
				<name>Log Mode</name>
				<type>LIST</type>
				<readonly>false</readonly>
				<default>Off</default>
				<items>
					<item>Off</item>
					<item>Print</item>
					<item>Log</item>
				</items>
			</property>
			<property>
				<name>Status</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default>Not started</default>
			</property>
			<property>
				<name>Appliance List</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default>Run the List Appliances action</default>
			</property>
			<property>
				<name>Driver Version</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default>0.3.4</default>
			</property>
		</properties>
	</config>
</devicedata>
