			</command>
			<command>
				<name>Clean Rooms</name>
				<command>CLEAN_ROOMS</command>
				<description>Clean rooms PARAM1 on NAME with cleaning mode PARAM2</description>
				<params>
					<param>
						<name>Rooms</name>
						<type>STRING</type>
					</param>
					<param>
						<name>Mode</name>
						<type>LIST</type>
						<items>
							<item>Device Setting</item>
							<item>Vacuum Only</item>
							<item>Vacuum and Mop</item>
							<item>Mop Only</item>
						</items>
					</param>
				</params>
			</command>
			<command>
				<name>Start Full Clean</name>
				<command>START_FULL_CLEAN</command>
				<description>Start a full clean on NAME with cleaning mode PARAM1, skipping if cleaned within PARAM2 hours (0 means no skip)</description>
				<params>
					<param>
						<name>Mode</name>
						<type>LIST</type>
						<items>
							<item>Device Setting</item>
							<item>Vacuum Only</item>
							<item>Vacuum and Mop</item>
							<item>Mop Only</item>
						</items>
					</param>
					<param>
						<name>Skip If Cleaned Within Hours</name>
						<type>RANGED_INTEGER</type>
						<minimum>0</minimum>
						<maximum>168</maximum>
						<default>0</default>
					</param>
				</params>
			</command>
			<command>
				<name>Set Cleaning Mode</name>
				<command>SET_CLEANING_MODE</command>
				<description>Set the cleaning mode of NAME to PARAM1</description>
				<params>
					<param>
						<name>Mode</name>
						<type>LIST</type>
						<items>
							<item>Vacuum Only</item>
							<item>Vacuum and Mop</item>
							<item>Mop Only</item>
						</items>
					</param>
				</params>
			</command>
		</commands>

		<actions>
