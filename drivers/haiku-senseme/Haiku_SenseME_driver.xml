<devicedata>
	<copyright>Copyright (c) 2026 - Custom / Unofficial Driver - Not affiliated with Big Ass Fans or Control4</copyright>
	<creator>Custom Driver Project</creator>
	<manufacturer>Big Ass Fans</manufacturer>
	<name>Haiku SenseME Fan</name>
	<model>Haiku / Haiku H / Haiku L / Haiku C</model>
	<created>08/14/2026 12:00 PM</created>
	<modified>08/14/2026 12:00 PM</modified>
	<version>100</version>
	<small image_source="c4z">icons/haiku_sm.png</small>
	<large image_source="c4z">icons/haiku_lg.png</large>
	<control>lua_gen</control>
	<controlmethod>ip</controlmethod>
	<driver>DriverWorks</driver>
	<templatedescription>Big Ass Fans Haiku (SenseME) - UDP Fan + Light Control</templatedescription>
	<search_types>
		<type>BigAssFans:fan:Haiku</type>
	</search_types>

	<proxies qty="2">
		<proxy proxybindingid="5001" name="Haiku Fan" image_source="c4z" small_image="icons/haiku_sm.png" large_image="icons/haiku_lg.png">fan</proxy>
		<proxy proxybindingid="5002" name="Haiku Light">light_v2</proxy>
	</proxies>

	<connections>
		<connection>
			<id>5001</id>
			<facing>6</facing>
			<connectionname>FAN</connectionname>
			<type>2</type>
			<consumer>False</consumer>
			<audiosource>False</audiosource>
			<videosource>False</videosource>
			<linelevel>False</linelevel>
			<classes>
				<class>
					<classname>FAN</classname>
				</class>
			</classes>
		</connection>
		<connection>
			<id>5002</id>
			<facing>6</facing>
			<connectionname>LIGHT</connectionname>
			<type>2</type>
			<consumer>False</consumer>
			<audiosource>False</audiosource>
			<videosource>False</videosource>
			<linelevel>False</linelevel>
			<classes>
				<class>
					<classname>LIGHT_V2</classname>
				</class>
			</classes>
		</connection>
		<connection>
			<id>6001</id>
			<facing>1</facing>
			<connectionname>Network</connectionname>
			<type>4</type>
			<consumer>True</consumer>
			<audiosource>False</audiosource>
			<videosource>False</videosource>
			<linelevel>True</linelevel>
			<classes>
				<class>
					<classname>UDP</classname>
					<ports>
						<port>
							<number>31415</number>
							<auto_connect>True</auto_connect>
							<monitor_connection>True</monitor_connection>
							<keep_connection>True</keep_connection>
						</port>
					</ports>
				</class>
			</classes>
		</connection>
	</connections>

	<!--
		NOTE: No <capabilities> block is included. The DriverWorks capability
		keys that are officially confirmed (via Control4's own light_sample.c4i)
		apply specifically to light_v2 (dimmer/set_level/ramp_level/on_off/etc.),
		and no equivalent officially-sourced key set for the FAN proxy could be
		verified for this combo driver. Rather than guess at fan capability keys,
		this block is omitted; add one in DriverEditor if you find it improves
		Navigator/Composer behavior for your OS version.
	-->

	<config>
		<power_management_method>AlwaysOn</power_management_method>
		<power_command_delay>0</power_command_delay>
		<power_delay>0</power_delay>
		<power_command_needed>False</power_command_needed>
		<documentation file="www\documentation.rtf" />
		<script file="driver.lua" />

		<commands>
			<command>
				<name>Rediscover Fan</name>
				<description>Broadcast a discovery request and re-resolve the fan's IP/MAC</description>
			</command>
			<command>
				<name>Set Whoosh Mode</name>
				<description>Turn Whoosh (natural breeze) mode on or off</description>
				<params>
					<param>
						<name>State</name>
						<type>LIST</type>
						<items>
							<item>ON</item>
							<item>OFF</item>
						</items>
					</param>
				</params>
			</command>
			<command>
				<name>Set Fan Direction</name>
				<description>Set fan rotation direction (seasonal reverse)</description>
				<params>
					<param>
						<name>Direction</name>
						<type>LIST</type>
						<items>
							<item>FWD</item>
							<item>REV</item>
						</items>
					</param>
				</params>
			</command>
		</commands>

		<actions>
			<action>
				<name> - Rediscover Fan</name>
				<command>ACTION_REDISCOVER</command>
			</action>
			<action>
				<name> - Whoosh On</name>
				<command>ACTION_WHOOSH_ON</command>
			</action>
			<action>
				<name> - Whoosh Off</name>
				<command>ACTION_WHOOSH_OFF</command>
			</action>
			<action>
				<name> - Print Debug Info</name>
				<command>ACTION_PRINT_DEBUG</command>
			</action>
		</actions>

		<properties>
			<property>
				<name>Fan IP Address</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default>0.0.0.0</default>
			</property>
			<property>
				<name>Fan Name (SenseME App Name)</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default></default>
			</property>
			<property>
				<name>Fan MAC Address</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default></default>
			</property>
			<property>
				<name>Has Light Kit</name>
				<type>LIST</type>
				<readonly>false</readonly>
				<default>Yes</default>
				<items>
					<item>Yes</item>
					<item>No</item>
				</items>
			</property>
			<property>
				<name>Max Fan Speed (0-7)</name>
				<type>LIST</type>
				<readonly>false</readonly>
				<default>7</default>
				<items>
					<item>1</item>
					<item>2</item>
					<item>3</item>
					<item>4</item>
					<item>5</item>
					<item>6</item>
					<item>7</item>
				</items>
			</property>
			<property>
				<name>Poll Interval (seconds)</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default>60</default>
			</property>
			<property>
				<name>Log Mode</name>
				<type>LIST</type>
				<readonly>false</readonly>
				<default>Off</default>
				<items>
					<item>Off</item>
					<item>Print</item>
					<item>Log</item>
					<item>Print and Log</item>
				</items>
			</property>
			<property>
				<name>Connection Status</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default>Unknown</default>
			</property>
		</properties>
	</config>

	<composer_categories>
		<category>Comfort</category>
	</composer_categories>
	<navigator_categories>
		<category>Comfort</category>
	</navigator_categories>
</devicedata>
