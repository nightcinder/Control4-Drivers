<devicedata>
	<copyright>Copyright (c) 2026 - Custom Driver - Free / self-built</copyright>
	<creator>Custom Driver Project</creator>
	<manufacturer>Custom Driver Project</manufacturer>
	<name>Room Light Helper</name>
	<model>Room Light Helper v1.4.0 (one instance per room)</model>
	<created>11/12/2026 10:00 PM</created>
	<modified>11/13/2026 10:23 PM</modified>
	<version>14</version>
	<control>lua_gen</control>
	<controlmethod>none</controlmethod>
	<driver>DriverWorks</driver>
	<combo>true</combo>
	<proxies />
	<capabilities />
	<templatedescription>Room Light Helper - requests a room light on and releases it, with a lux-based level and an off delay</templatedescription>

	<config>
		<script file="driver.lua" />
		<properties>
			<property>
				<name>Room Name</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default>Laundry</default>
			</property>
			<property>
				<name>Room Light ID</name>
				<type>RANGED_INTEGER</type>
				<minimum>0</minimum>
				<maximum>99999</maximum>
				<readonly>false</readonly>
				<default>0</default>
			</property>
			<property>
				<name>Driver Version</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default>1.4.0</default>
			</property>
			<property>
				<name>Status</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default>Idle</default>
			</property>
			<property>
				<name>Light State</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default>Idle</default>
			</property>
			<property>
				<name>Active Sources</name>
				<type>STRING</type>
				<readonly>true</readonly>
				<default>None</default>
			</property>
			<property>
				<name>Min Level</name>
				<type>RANGED_INTEGER</type>
				<minimum>0</minimum>
				<maximum>100</maximum>
				<readonly>false</readonly>
				<default>20</default>
			</property>
			<property>
				<name>Max Level</name>
				<type>RANGED_INTEGER</type>
				<minimum>0</minimum>
				<maximum>100</maximum>
				<readonly>false</readonly>
				<default>100</default>
			</property>
			<property>
				<name>Fallback Level</name>
				<type>RANGED_INTEGER</type>
				<minimum>0</minimum>
				<maximum>100</maximum>
				<readonly>false</readonly>
				<default>60</default>
			</property>
			<property>
				<name>Lux Low</name>
				<type>RANGED_INTEGER</type>
				<minimum>0</minimum>
				<maximum>100000</maximum>
				<readonly>false</readonly>
				<default>20</default>
			</property>
			<property>
				<name>Lux High</name>
				<type>RANGED_INTEGER</type>
				<minimum>0</minimum>
				<maximum>100000</maximum>
				<readonly>false</readonly>
				<default>300</default>
			</property>
			<property>
				<name>Lux Max Age (min)</name>
				<type>RANGED_INTEGER</type>
				<minimum>1</minimum>
				<maximum>1440</maximum>
				<readonly>false</readonly>
				<default>30</default>
			</property>
			<property>
				<name>Off Delay (sec)</name>
				<type>RANGED_INTEGER</type>
				<minimum>0</minimum>
				<maximum>3600</maximum>
				<readonly>false</readonly>
				<default>180</default>
			</property>
			<property>
				<name>Quick Off Delay (sec)</name>
				<type>RANGED_INTEGER</type>
				<minimum>0</minimum>
				<maximum>3600</maximum>
				<readonly>false</readonly>
				<default>90</default>
			</property>
			<property>
				<name>Fade In (sec)</name>
				<type>RANGED_INTEGER</type>
				<minimum>0</minimum>
				<maximum>60</maximum>
				<readonly>false</readonly>
				<default>5</default>
			</property>
			<property>
				<name>Fade Out (sec)</name>
				<type>RANGED_INTEGER</type>
				<minimum>0</minimum>
				<maximum>300</maximum>
				<readonly>false</readonly>
				<default>30</default>
			</property>
			<property>
				<name>Quick-Release Sources</name>
				<type>STRING</type>
				<readonly>false</readonly>
				<default>Roborock</default>
			</property>
			<property>
				<name>Source Timeout (min)</name>
				<type>RANGED_INTEGER</type>
				<minimum>1</minimum>
				<maximum>1440</maximum>
				<readonly>false</readonly>
				<default>120</default>
			</property>
			<property>
				<name>Debug</name>
				<type>LIST</type>
				<readonly>false</readonly>
				<default>Off</default>
				<items>
					<item>Off</item>
					<item>On</item>
				</items>
			</property>
		</properties>

		<commands>
			<command>
				<name>REQUEST_ON</name>
				<description>Request On: turn the room light on for Source</description>
				<params>
					<param>
						<name>Source</name>
						<type>STRING</type>
					</param>
				</params>
			</command>
			<command>
				<name>RELEASE</name>
				<description>Release: release Source from the room light</description>
				<params>
					<param>
						<name>Source</name>
						<type>STRING</type>
					</param>
				</params>
			</command>
			<command>
				<name>RELEASE_ALL</name>
				<description>Release All: release every source from the room light</description>
			</command>
			<command>
				<name>SET_LUX</name>
				<description>Set Lux: report the current lux reading for the room</description>
				<params>
					<param>
						<name>Lux</name>
						<type>RANGED_INTEGER</type>
						<minimum>0</minimum>
						<maximum>100000</maximum>
					</param>
				</params>
			</command>
		</commands>
	</config>

	<events>
		<event>
			<id>1</id>
			<name>Light Turned On By Helper</name>
			<description>The helper turned the room light on</description>
		</event>
		<event>
			<id>2</id>
			<name>Light Turned Off By Helper</name>
			<description>The helper turned the room light off after the last source released</description>
		</event>
		<event>
			<id>3</id>
			<name>Source Timeout</name>
			<description>A source was auto-released after Source Timeout (min)</description>
		</event>
	</events>
</devicedata>
