	<!--
		STRUCTURE: <capabilities> is a TOP-LEVEL sibling of <connections>/
		<config>, per the Phase 0 fix (see decision record above) - NOT
		nested inside <connection><classes><class> the way v102's Pool
		capabilities were. Confirmed against this project's real, working
		IntelliFire v113 driver and live-tested clean against the real EA-1
		via the Phase 0 throwaway driver before being carried into this
		file.

		VALUES: mirror the Phase 0 throwaway test driver's proven-clean set
		as closely as makes sense for a real device (can_heat/hvac_states
		rather than has_single_setpoint, since that combination is the one
		actually confirmed structurally valid live - has_single_setpoint
		was never live-tested). setpoint_heat_min/max_f mirror this driver's
		own "Target Temp Min/Max (F)" properties (60/115 default) - same
		known limitation v102 had: if those properties are changed, this
		static capability won't update without reloading the driver.
	-->
	<capabilities>
		<has_remote_sensor>false</has_remote_sensor>
		<can_heat>true</can_heat>
		<can_cool>false</can_cool>
		<can_change_scale>false</can_change_scale>
		<has_extras>true</has_extras>
		<has_single_setpoint>false</has_single_setpoint>
		<can_do_auto>false</can_do_auto>
		<can_auto>false</can_auto>
		<can_calibrate>false</can_calibrate>

		<setpoint_heat_min_f>60</setpoint_heat_min_f>
		<setpoint_heat_max_f>115</setpoint_heat_max_f>
		<setpoint_heat_min_c>16</setpoint_heat_min_c>
		<setpoint_heat_max_c>46</setpoint_heat_max_c>
		<setpoint_heat_min>60</setpoint_heat_min>
		<setpoint_heat_max>115</setpoint_heat_max>

		<fan_states>Off</fan_states>
		<hvac_states>Off,Heat</hvac_states>
		<hvac_modes>Off,Heat</hvac_modes>
		<has_connection_status>true</has_connection_status>

		<can_preset_schedule>false</can_preset_schedule>
		<can_preset>false</can_preset>
	</capabilities>

