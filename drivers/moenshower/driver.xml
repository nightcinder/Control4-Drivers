		<commands>
			<command>
				<name>Shower On</name>
				<description>Turn the shower on (resumes the active preset if one is paused, otherwise a plain on with no preset)</description>
			</command>
			<command>
				<name>Shower Off</name>
				<description>Turn the shower off</description>
			</command>
			<command>
				<name>Set Temperature</name>
				<description>Set the target temperature (F) while the shower is running</description>
				<params>
					<param>
						<name>Temperature</name>
						<type>STRING</type>
					</param>
				</params>
			</command>
			<command>
				<name>Activate Preset</name>
				<description>Activate a saved Moen shower preset by its position number</description>
				<params>
					<param>
						<name>Position</name>
						<type>LIST</type>
						<items>
							<item>1</item>
							<item>2</item>
							<item>3</item>
							<item>4</item>
						</items>
					</param>
				</params>
			</command>
			<command>
				<name>Resume Paused Shower</name>
				<description>Resume water flow after a preset paused it at temperature (mode = paused-by-preset)</description>
			</command>
			<command>
				<name>Refresh Status</name>
				<description>Poll Moen's cloud immediately instead of waiting for the next scheduled poll</description>
			</command>
			<!--
				Set Outlet is also reachable from the web view's outlet toggles.
			-->
			<command>
				<name>Set Outlet</name>
				<description>Turn a single outlet on/off directly (bypasses presets)</description>
				<params>
					<param>
						<name>Outlet</name>
						<type>LIST</type>
						<items>
							<item>1</item>
							<item>2</item>
							<item>3</item>
							<item>4</item>
						</items>
					</param>
					<param>
						<name>State</name>
						<type>LIST</type>
						<items>
							<item>ON</item>
							<item>OFF</item>
						</items>
					</param>
				</params>
			</command>
		</commands>

